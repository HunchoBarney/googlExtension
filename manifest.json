{
  "manifest_version": 3,
  "name": "PMEx Market Matcher",
  "description": "Read-only article matching and live public market data from Polymarket and Hyperliquid.",
  "version": "0.1.0",
  "action": {
    "default_title": "Find market matches",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/serviceWorker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y",
        "linux": "Ctrl+Shift+Y",
        "chromeos": "Ctrl+Shift+Y",
        "mac": "MacCtrl+Shift+P"
      },
      "description": "Find market matches"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://gamma-api.polymarket.com/*",
    "https://data-api.polymarket.com/*",
    "https://clob.polymarket.com/*",
    "https://api.hyperliquid.xyz/*"
  ]
}
